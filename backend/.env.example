# Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model overrides (defaults shown; swap to claude-sonnet-5 for a "quality mode" comparison)
GENERATION_MODEL=claude-haiku-4-5-20251001
ROUTING_MODEL=claude-haiku-4-5-20251001
RAGAS_JUDGE_MODEL=claude-haiku-4-5-20251001

# Allowed frontend origins for CORS, comma-separated. Defaults to localhost:3000 if unset.
# When deploying, add your Vercel URL, e.g.:
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
